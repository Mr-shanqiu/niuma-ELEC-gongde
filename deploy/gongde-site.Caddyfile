{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Mutable entry points must revalidate. Only content-addressed files are
	# immutable; a query such as ?v=release-name alone is not that guarantee.
	route {
		header Cache-Control "no-cache"
		@immutable path_regexp immutable ^/(assets/runtime/[a-f0-9]{64}/[A-Za-z0-9._/-]+[.](js|css)|assets/previews/public/[a-f0-9]{64}/[A-Za-z0-9._-]+[.](png|webp)|admin/assets/[A-Za-z0-9_-]+-[A-Za-z0-9_-]{8,64}[.](js|css))$
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@health path /healthz.txt
		header @health Cache-Control "no-store"
		file_server
	}
	handle_errors {
		header Cache-Control "no-store"
		@not_found expression {err.status_code} == 404
		rewrite @not_found /404.html
		file_server
	}
}
