// Keep this file ASCII-only. The resource compiler decodes .rc files with the
// system code page, and this project cannot run a Windows build locally to
// verify that non-ASCII resource strings are not mangled.
//
// Numeric constants are used instead of #include <windows.h> to avoid pulling
// in windows.h definitions that conflict with the resource compiler (e.g.
// duplicate MANIFEST entries causing CVT1100).

// RT_MANIFEST = 24
1 24 "app.manifest"
// RCDATA = 10
101 10 "woodfish.png"
102 10 "mallet.png"
110 10 "developer-douyin.png"
// ICON is a resource-script keyword. Do not replace it with numeric type 1:
// Win32 resource type 1 is RT_CURSOR, not an application icon.
103 ICON "appicon.ico"

// Native About dialog; strings are localized by app.cpp, not by the RC compiler.
// WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_SETFONT.
3000 DIALOGEX 0, 0, 310, 300
STYLE 0x80C800C0
CAPTION "About NiuMa Merit"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "", 3001, 12, 12, 286, 140
  // WS_CHILD | WS_VISIBLE | SS_OWNERDRAW.
  CONTROL "", 3002, "STATIC", 0x5000000D, 80, 155, 150, 120
  DEFPUSHBUTTON "OK", 1, 248, 281, 50, 14
END

// RT_VERSION = 16; the VERSIONINFO resource identifier must be numeric 1.
// No Windows headers are included here, so VS_VERSION_INFO is not a macro.
1 VERSIONINFO
  FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  FILEFLAGSMASK 0x3F
  FILEFLAGS 0x0
  FILEOS 0x40004
  FILETYPE 0x1
  FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Mr-shanqiu"
      VALUE "FileDescription", "NiuMa Merit"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "niuma-merit"
      VALUE "LegalCopyright", "Copyright (c) 2026 Mr-shanqiu"
      VALUE "OriginalFilename", "niuma-merit.exe"
      VALUE "ProductName", "NiuMa Merit"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
