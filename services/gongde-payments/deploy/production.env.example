NODE_ENV=production
HOST=0.0.0.0
PORT=8080
GONGDE_PAYMENT_MODE=live
GONGDE_STORE_MODE=mysql
GONGDE_SMS_MODE=live
GONGDE_PACK_DELIVERY_MODE=local
GONGDE_MYSQL_HOST=zqscreen-mysql-1
GONGDE_MYSQL_PORT=3306
GONGDE_MYSQL_DATABASE=gongde
GONGDE_MYSQL_USER=gongde_app
GONGDE_MYSQL_PASSWORD_FILE=/run/secrets/gongde_mysql_app_password
GONGDE_MYSQL_CONNECTION_LIMIT=4
GONGDE_SMS_IDENTITY_SECRET_FILE=/run/secrets/gongde_sms_identity_secret
GONGDE_SMS_REDIS_URL_FILE=/run/secrets/gongde_sms_redis_url
TENCENT_CLOUD_SECRET_ID_FILE=/run/secrets/tencent_cloud_secret_id
TENCENT_CLOUD_SECRET_KEY_FILE=/run/secrets/tencent_cloud_secret_key
TENCENT_CLOUD_SMS_SDK_APP_ID=
TENCENT_CLOUD_SMS_GONGDE_SIGN_NAME=智家
TENCENT_CLOUD_SMS_GONGDE_LOGIN_TEMPLATE_ID=
WECHAT_PAY_ENABLED=true
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/wechat/refund-notify
WECHAT_PAY_MERCHANT_PRIVATE_KEY_FILE=/run/secrets/wechat_pay_merchant_private_key
WECHAT_PAY_PUBLIC_KEY_FILE=/run/secrets/wechat_pay_public_key
WECHAT_PAY_API_V3_KEY_FILE=/run/secrets/wechat_pay_api_v3_key
ALIPAY_ENABLED=true
ALIPAY_WAP_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/alipay/notify
ALIPAY_RETURN_URL=https://gongde.zqscreen.cn/index.html
ALIPAY_APP_PRIVATE_KEY_FILE=/run/secrets/alipay_app_private_key
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay_public_key
GONGDE_PACK_ASSET_ROOT=/app/assets
GONGDE_PACK_SIGNING_KEY_FILE=/run/secrets/gongde_pack_signing_key
