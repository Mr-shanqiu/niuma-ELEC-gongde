GONGDE_PAYMENT_MODE=disabled
GONGDE_STORE_MODE=memory
GONGDE_SMS_MODE=disabled
GONGDE_PACK_DELIVERY_MODE=disabled
HOST=127.0.0.1
PORT=8787

# Optional single-admin console. Leave all three unset to keep it disabled.
GONGDE_ADMIN_USERNAME=admin
GONGDE_ADMIN_PASSWORD_FILE=/run/secrets/gongde_admin_password
GONGDE_ADMIN_SESSION_SECRET_FILE=/run/secrets/gongde_admin_session_secret
GONGDE_ADMIN_COOKIE_SECURE=false

# Fan-group code preparation. Three-day windows start at Beijing midnight.
# Keep disabled until the free grant flow and author permissions are accepted.
# Dedicated secret file: 32 random bytes encoded as exactly 64 hex characters.
# Preserve the secret and activation anchor across service releases/restarts.
GONGDE_GROUP_BENEFIT_CODES_ENABLED=false
GONGDE_GROUP_BENEFIT_SECRET_FILE=/run/secrets/gongde_group_benefit_secret
GONGDE_GROUP_BENEFIT_START_AT=2026-10-08T00:00:00+08:00

# PRD 1.1 permanent free distribution; enable only after both 0.9.0 installers
# and additive SQL008/009 are deployed. Preserve historical order callbacks.
GONGDE_FREE_DISTRIBUTION_ENABLED=false
GONGDE_NEW_PAYMENTS_DISABLED=false
GONGDE_FREE_DISTRIBUTION_SECRET_FILE=/run/secrets/gongde_free_distribution_secret
# Optional administrator-managed manifest; otherwise the bundled manifest is read.
GONGDE_FREE_INSTALLERS_FILE=

# Only for local mock mode. Use at least 24 random characters and never deploy it.
GONGDE_PAYMENT_TEST_TOKEN=

# Live provider identifiers and callback URLs. Live mode remains hard-disabled.
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/wechat/refund-notify
WECHAT_PAY_MERCHANT_PRIVATE_KEY_FILE=/run/secrets/gongde_wechat_merchant_private_key
WECHAT_PAY_PUBLIC_KEY_FILE=/run/secrets/gongde_wechat_public_key
WECHAT_PAY_API_V3_KEY_FILE=/run/secrets/gongde_wechat_api_v3_key

ALIPAY_ENABLED=false
ALIPAY_WAP_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/alipay/notify
ALIPAY_RETURN_URL=https://gongde.zqscreen.cn/index.html
ALIPAY_APP_PRIVATE_KEY_FILE=/run/secrets/gongde_alipay_app_private_key
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/gongde_alipay_public_key

# MySQL, Redis, SMS identity and provider credentials are supplied through
# independent read-only files in production. See README.md for the full list.
GONGDE_COS_BUCKET=gongde-download-1460392746
GONGDE_COS_REGION=ap-shanghai
GONGDE_COS_PUBLIC_BASE_URL=https://download.gongde.zqscreen.cn
GONGDE_COS_SECRET_ID_FILE=/run/secrets/gongde_cos_secret_id
GONGDE_COS_SECRET_KEY_FILE=/run/secrets/gongde_cos_secret_key

# Free creator community. Keep disabled until migrations, review UI, private
# storage permissions, free delivery and client import are accepted together.
GONGDE_CREATORS_ENABLED=false
GONGDE_CREATOR_PAID_SALES_ENABLED=false
GONGDE_CREATOR_SETTLEMENTS_ENABLED=false
GONGDE_CREATOR_FREE_DOWNLOADS_ENABLED=false
GONGDE_CREATOR_CLIENT_COMPATIBILITY_ACCEPTED=false
# Exact trusted reverse-proxy socket addresses, no CIDR or inferred trust.
# The trusted proxy must overwrite X-Real-IP with its actual client address.
GONGDE_CREATOR_TRUSTED_PROXY_ADDRESSES=
GONGDE_CREATOR_PUBLIC_ORIGIN=https://gongde.zqscreen.cn
GONGDE_CREATOR_COS_BUCKET=gongde-paid-1460392746
GONGDE_CREATOR_COS_REGION=ap-shanghai
GONGDE_CREATOR_COS_SECRET_ID_FILE=/run/secrets/gongde_creator_cos_secret_id
GONGDE_CREATOR_COS_SECRET_KEY_FILE=/run/secrets/gongde_creator_cos_secret_key
