GONGDE_PAYMENT_MODE=disabled
GONGDE_STORE_MODE=memory
GONGDE_SMS_MODE=disabled
GONGDE_PACK_DELIVERY_MODE=disabled
HOST=127.0.0.1
PORT=8787

# Optional single-admin console. Leave all three unset to keep it disabled.
GONGDE_ADMIN_USERNAME=admin
GONGDE_ADMIN_PASSWORD_FILE=/run/secrets/gongde_admin_password
GONGDE_ADMIN_SESSION_SECRET_FILE=/run/secrets/gongde_admin_session_secret
GONGDE_ADMIN_COOKIE_SECURE=false

# Only for local mock mode. Use at least 24 random characters and never deploy it.
GONGDE_PAYMENT_TEST_TOKEN=

# Live provider identifiers and callback URLs. Live mode remains hard-disabled.
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/wechat/refund-notify
WECHAT_PAY_MERCHANT_PRIVATE_KEY_FILE=/run/secrets/gongde_wechat_merchant_private_key
WECHAT_PAY_PUBLIC_KEY_FILE=/run/secrets/gongde_wechat_public_key
WECHAT_PAY_API_V3_KEY_FILE=/run/secrets/gongde_wechat_api_v3_key

ALIPAY_ENABLED=false
ALIPAY_WAP_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=https://gongde.zqscreen.cn/api/gongde/payments/alipay/notify
ALIPAY_RETURN_URL=https://gongde.zqscreen.cn/index.html
ALIPAY_APP_PRIVATE_KEY_FILE=/run/secrets/gongde_alipay_app_private_key
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/gongde_alipay_public_key

# MySQL, Redis, SMS identity and provider credentials are supplied through
# independent read-only files in production. See README.md for the full list.
GONGDE_COS_BUCKET=gongde-download-1460392746
GONGDE_COS_REGION=ap-shanghai
GONGDE_COS_PUBLIC_BASE_URL=https://download.gongde.zqscreen.cn
GONGDE_COS_SECRET_ID_FILE=/run/secrets/gongde_cos_secret_id
GONGDE_COS_SECRET_KEY_FILE=/run/secrets/gongde_cos_secret_key
